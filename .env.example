AUTH_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes
AUTH_REFRESH_TOKEN_SECRET=replace_with_a_different_32_byte_random_secret
AUTH_PHONE_SECRET=replace_with_at_least_32_random_bytes
PAYMENT_ALIPAY_ENABLED=false
PAYMENT_CALLBACK_BASE_URL=https://domain.example
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_APP_CERT_PATH=./certs/appPublicCert.crt
ALIPAY_PUBLIC_KEY_PATH=./certs/alipayPublicCert.crt
ALIPAY_ROOT_KEY_PATH=./certs/alipayRootCert.crt
SNOWFLAKE_NODE_ID=your_node_id
ALIPAY_NOTIFY_URL=https://domain.example/v1/payments/alipay/notify
ALIPAY_RETURN_URL=http://domain.example/alipay/return_url
PAYMENT_WECHAT_ENABLED=false
WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_merchant_id
WECHAT_API_KEY=your_wechat_api_key
WECHAT_NOTIFY_URL=https://domain.example/v1/payments/wechat/notify
WECHAT_RETURN_URL=https://domain.example/wechat/return_url
