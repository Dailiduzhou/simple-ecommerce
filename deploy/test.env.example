# Copy to /opt/simple-ecommerce-test/.env on the SERVER, never commit real values.
# docker compose reads this file; deployment scripts never source it as shell code.
APP_IS_PRODUCTION=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_SOURCE=postgres://postgres:REPLACE_PASSWORD@postgres:5432/ecommerce?sslmode=disable
DATABASE_MIGRATION_SOURCE=
DATABASE_DISABLE_MIGRATIONS=false
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_PHONE_SECRET=
SNOWFLAKE_NODE_ID=1

# HTTP is loopback-only by default. Put an HTTPS reverse proxy in front of it.
MALL_BIND_ADDRESS=127.0.0.1
MALL_HTTP_PORT=8000

# Start MinIO from an existing LOCAL image. Use its exact repository:tag/digest.
COMPOSE_PROFILES=storage
MINIO_IMAGE=ecommerce-minio:local
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
# If MinIO is ALREADY running, leave COMPOSE_PROFILES empty, omit administrator
# credentials, and set STORAGE_ENDPOINT to its reachable API host:port instead.
STORAGE_ENDPOINT=minio:9000
# No scheme or path. Must be reachable by browsers, not localhost/minio:9000.
# This is the S3 API endpoint, NOT the :9001 management console.
STORAGE_PUBLIC_ENDPOINT=oss-test.example.com
STORAGE_BUCKET=ecommerce-test-images
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# HTTP only inside this isolated Docker network; public traffic must use HTTPS.
# allow_insecure is an explicit TEST-ONLY opt-out needed for the internal HTTP hop.
# Prefer TLS on both hops and allow_insecure=false whenever available.
STORAGE_USE_TLS=false
STORAGE_PUBLIC_USE_TLS=true
STORAGE_ALLOW_INSECURE=true

PAYMENT_ALIPAY_ENABLED=false
ALIPAY_IS_PRODUCTION=false
PAYMENT_WECHAT_ENABLED=false
WECHAT_IS_PRODUCTION=false
PAYMENT_CALLBACK_BASE_URL=
