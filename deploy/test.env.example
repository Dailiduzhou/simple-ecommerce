# Copy to /opt/simple-ecommerce-test/.env on the SERVER. Never commit real values.
# Deployment uses base + test + caddy overlays; scripts never source this as shell code.
# Replace the four example.com names with real, distinct public DNS names that all
# point at the server; Compose refuses to start while any of them is empty. Caddy
# then manages one certificate per name (no wildcard, no DNS API credentials).
WEB_DOMAIN=web.example.com
API_DOMAIN=api.example.com
MINIO_DOMAIN=minio.example.com
CONSOLE_DOMAIN=console.example.com
# Absolute persistent directory containing the separately built frontend index.html.
WEB_ROOT=/opt/simple-ecommerce-test/web
# Space-separated administrator public IPs/CIDRs. Loopback default denies public access.
# Example: CONSOLE_ALLOWED_CIDRS="203.0.113.10/32 2001:db8::1/128"
CONSOLE_ALLOWED_CIDRS="127.0.0.1/32 ::1/128"

APP_IS_PRODUCTION=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_SOURCE=postgres://postgres:REPLACE_PASSWORD@postgres:5432/ecommerce?sslmode=disable
DATABASE_MIGRATION_SOURCE=
DATABASE_DISABLE_MIGRATIONS=false
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_PHONE_SECRET=
SNOWFLAKE_NODE_ID=1
OTEL_TRACES_SAMPLER_ARG=0.1

# Normal deployments receive both immutable image references from CI, overriding
# this value. For manual bootstrap, fill a published ACR MinIO tag or digest:
# MINIO_IMAGE=<ACR_REGISTRY>/<ACR_NAMESPACE>/aiyoung:minio-<last-8-commit-characters>
MINIO_IMAGE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The Caddy overlay ignores these two and derives both from MINIO_DOMAIN over TLS.
# They stay non-empty because the Caddy-less base + test overlay still requires
# them; fill in your own externally reachable S3 API endpoint for that mode.
STORAGE_ENDPOINT=minio.example.com
STORAGE_PUBLIC_ENDPOINT=minio.example.com
STORAGE_BUCKET=ecommerce-test-images
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_TLS=true
STORAGE_PUBLIC_USE_TLS=true
STORAGE_ALLOW_INSECURE=false

PAYMENT_ALIPAY_ENABLED=false
ALIPAY_IS_PRODUCTION=false
PAYMENT_WECHAT_ENABLED=false
WECHAT_IS_PRODUCTION=false
PAYMENT_CALLBACK_BASE_URL=https://api.example.com
# Set the per-provider notify URLs only when that provider is enabled; they must
# match the public API domain, not the internal service name.
